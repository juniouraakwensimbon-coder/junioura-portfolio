{
  "name": "junioura-akwensimbom-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Junioura Akwensimbom — Web Developer, Digital Communications, Educator. Built with Node.js, Express and EJS; exported as a static site for GitHub Pages.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch src --watch public --ext js,ejs,css server.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/preview.js",
    "check": "node scripts/check.js",
    "test": "node --test"
  },
  "keywords": [
    "portfolio",
    "nodejs",
    "express",
    "ejs",
    "github-pages"
  ],
  "author": "Junioura Akwensimbom",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
