# Copy this file to .env and fill in your own values.
# .env is ignored by Git — never commit real passwords.

# Server Configuration
PORT=3002
NODE_ENV=development

# Mail Configuration (Nodemailer) — only used by the local Node server's
# contact form. The GitHub Pages version opens the visitor's email app instead.
# For Gmail, use an App Password (not your normal password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_TO=juniouraakwensimbon@gmail.com
