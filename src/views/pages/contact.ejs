<section id="contact" class="contact section-reveal">
    <div class="container">
        <div class="contact-wrapper">
            <div class="contact-info">
                <h2 class="section-title text-left">Let's Collaborate</h2>
                <p>Whether you have a project in mind, need a tech educator, or want to discuss business, I'm always open to new opportunities.</p>
                
                <ul class="contact-details">
                    <li>
                        <div class="icon-box"><i class="fa-solid fa-envelope"></i></div>
                        <div>
                            <strong>Email</strong>
                            <a href="mailto:<%= owner.email %>"><%= owner.email %></a>
                        </div>
                    </li>
                    <li>
                        <div class="icon-box"><i class="fa-solid fa-phone"></i></div>
                        <div>
                            <strong>Phone</strong>
                            <a href="tel:<%= owner.phone.replace(/\s/g, '') %>"><%= owner.phone %></a>
                        </div>
                    </li>
                    <li>
                        <div class="icon-box"><i class="fa-solid fa-location-dot"></i></div>
                        <div>
                            <strong>Location</strong>
                            <span><%= owner.location %></span>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="contact-form-wrapper">
                <% if (success) { %>
                    <div class="alert alert-success">
                        <i class="fa-solid fa-circle-check"></i>
                        <h3>Message Sent!</h3>
                        <p>Thank you for reaching out. I will get back to you as soon as possible.</p>
                        <a href="/contact" class="btn btn-primary mt-3">Send Another Message</a>
                    </div>
                <% } else { %>
                    <form action="/contact" method="POST" class="custom-form">
                        <% if (errors && errors.length > 0) { %>
                            <div class="alert alert-danger">
                                <ul>
                                    <% errors.forEach(err => { %>
                                        <li><%= err.msg %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <div class="form-group">
                            <label for="name">Name</label>
                            <input type="text" name="name" id="name" placeholder="John Doe" value="<%= values.name || '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" name="email" id="email" placeholder="john@example.com" value="<%= values.email || '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="subject">Subject</label>
                            <input type="text" name="subject" id="subject" placeholder="Project Inquiry" value="<%= values.subject || '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea name="message" id="message" rows="5" placeholder="Tell me about your project..." required><%= values.message || '' %></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            Send Message <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
</section>
