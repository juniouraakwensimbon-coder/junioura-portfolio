<%#
  One lesson of the Beginner HTML and CSS Learning Program.
  The lesson text lives in src/views/lessons/<slug>.ejs and uses the same
  nine section ids on every lesson, so the contents list below always matches.
%><%
  const parts = [
    ['introduction', 'Introduction'], ['learn', 'What you will learn'], ['explanation', 'Explanation'],
    ['demonstration', 'Demonstration'], ['practice', 'Hands-on practice'], ['check', 'Check your understanding'],
    ['mistakes', 'Common mistakes'], ['summary', 'Lesson summary'], ['next', 'What comes next'],
  ];
  const phase = course.phases.find(p => p.id === course.calendar.find(c => c.n === lesson.n).phase);
%>
<section class="page-hero lesson-hero" aria-labelledby="page-title">
  <div class="container">
    <a class="lesson-back" href="<%= pageUrl('edu', 'programme') %>"><%- include('../partials/icon', { name: 'arrow' }) %> Beginner HTML and CSS Learning Program</a>
    <p class="lesson-kicker">Lesson <%= lesson.n %> of 30</p>
    <h1 id="page-title" class="page-title"><%= lesson.title %></h1>
    <p class="page-intro"><%= lesson.summary %></p>
    <ul class="lesson-meta">
      <li>About 2 hours</li><li>Complete beginners</li><li><%= phase.title %></li>
    </ul>
  </div>
</section>

<div class="section section-white lesson-section">
  <div class="container lesson-layout">
    <nav class="lesson-toc" aria-label="In this lesson">
      <p class="lesson-toc-label">In this lesson</p>
      <ol><% parts.forEach(([id, label]) => { %><li><a href="#<%= id %>"><%= label %></a></li><% }) %></ol>
    </nav>

    <article class="lesson-body" aria-labelledby="page-title">
      <% if (lesson.developed) { %>
        <aside class="lesson-notice" aria-label="About this lesson">
          <p class="lesson-notice-title">Developed from the lesson outline</p>
          <p>The original notes for this lesson set out its objectives, timing and practical outcome. The step-by-step explanation, demonstration and exercises below were developed from that outline and are proposed teaching material.</p>
        </aside>
      <% } %>
      <%- include('../lessons/' + lesson.slug) %>
    </article>
  </div>
</div>

<nav class="section section-cool lesson-pager-wrap" aria-label="Lessons">
  <div class="container lesson-pager">
    <% if (prev) { %>
      <a class="lesson-pager-link" href="<%= lessonUrl(prev.slug) %>" rel="prev"><span class="lesson-pager-dir">Previous lesson</span><span class="lesson-pager-title">Lesson <%= prev.n %>: <%= prev.title %></span></a>
    <% } else { %>
      <a class="lesson-pager-link" href="<%= pageUrl('edu', 'programme') %>"><span class="lesson-pager-dir">Back to</span><span class="lesson-pager-title">The program overview</span></a>
    <% } %>
    <% if (next) { %>
      <a class="lesson-pager-link lesson-pager-next" href="<%= lessonUrl(next.slug) %>" rel="next"><span class="lesson-pager-dir">Next lesson</span><span class="lesson-pager-title">Lesson <%= next.n %>: <%= next.title %></span></a>
    <% } else { %>
      <a class="lesson-pager-link lesson-pager-next" href="<%= pageUrl('edu', 'lessons') %>"><span class="lesson-pager-dir">Lessons 6–30</span><span class="lesson-pager-title">See the full lesson sequence</span></a>
    <% } %>
  </div>
</nav>
