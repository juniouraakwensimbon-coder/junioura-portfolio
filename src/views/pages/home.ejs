<%# ============================== HERO ============================== %>
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title"><%= owner.name %></h1>
      <p class="hero-role">Web developer, digital communicator and educator in <%= owner.location %>.</p>
      <p class="hero-lead"><%= owner.headline %></p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">See my work</a>
        <a class="link-quiet" href="#contact">Get in touch</a>
      </div>

      <p class="hero-now">Currently managing the AAGYW-CAM website and creating digital literacy content for Junioura Creative WebDev.</p>
    </div>

    <figure class="hero-figure">
      <img src="<%= asset(owner.photo.src) %>" width="<%= owner.photo.width %>" height="<%= owner.photo.height %>" alt="<%= owner.photo.alt %>" fetchpriority="high">
    </figure>
  </div>
</section>

<%# ============================== ABOUT ============================== %>
<section class="section section-white" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-lead">
      <h2 id="about-title" class="section-title">About</h2>
      <p class="about-statement"><%= intro[2] %></p>
    </div>

    <div class="about-side">
      <div class="about-text">
        <p><%= intro[0] %> <%= intro[1] %></p>
        <p>I studied Biochemistry, trained as a Biology teacher, and then completed a year of intensive web and application development training. Teaching shaped how I work: I plan clearly, explain simply, and think about the person on the other side of the screen.</p>
      </div>
      <dl class="facts">
        <% facts.forEach(f => { %>
          <div><dt><%= f.term %></dt><dd><%= f.detail %></dd></div>
        <% }) %>
      </dl>
    </div>
  </div>
</section>

<%# ============================== SERVICES ============================== %>
<section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="services-head">
      <h2 id="services-title" class="section-title">Services</h2>
      <p class="section-intro">What you can ask me to do, and what you get from it.</p>
    </div>

    <ul class="service-list">
      <% services.forEach(s => { %>
        <li class="service" id="service-<%= s.slug %>">
          <h3 class="service-title"><%= s.title %></h3>
          <div class="service-text">
            <p><%= s.summary %> <%= s.value %></p>
            <p class="service-includes">Includes <%= s.includes.map((x, i) => i === 0 ? x.charAt(0).toLowerCase() + x.slice(1) : x.charAt(0).toLowerCase() + x.slice(1)).join(', ').replace(/, ([^,]*)$/, ' and $1') %>.</p>
            <a class="text-link" href="#contact" data-subject="<%= s.subject %>">Enquire<span class="visually-hidden"> about <%= s.title %></span> <%- include('../partials/icon', { name: 'arrow' }) %></a>
          </div>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<%# ============================== WORK ============================== %>
<section class="section section-white" id="work" aria-labelledby="work-title">
  <div class="container">
    <h2 id="work-title" class="section-title">Selected work</h2>

    <% const [aagyw, jcw, nexinch, teaching] = projects; %>

    <%# Lead project: text-led, details beside it %>
    <article class="work-lead" id="project-<%= aagyw.slug %>" aria-labelledby="project-<%= aagyw.slug %>-title">
      <div class="work-lead-main">
        <p class="work-kicker"><%= aagyw.category %></p>
        <h3 class="work-title" id="project-<%= aagyw.slug %>-title"><%= aagyw.title %></h3>
        <p class="work-org"><%= aagyw.organisation %></p>
        <p class="work-desc"><%= aagyw.desc %></p>
        <% aagyw.links.filter(l => l.show).forEach(l => { %>
          <a class="text-link" href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.label %> <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
        <% }) %>
      </div>
      <dl class="work-details">
        <div><dt>Role</dt><dd><%= aagyw.role %></dd></div>
        <div><dt>Tools</dt><dd><%= aagyw.tools.join(', ') %></dd></div>
        <div><dt>Scope</dt><dd><%= aagyw.scope.join(', ') %></dd></div>
      </dl>
    </article>

    <%# Image-led project: real designs %>
    <article class="work-feature" id="project-<%= jcw.slug %>" aria-labelledby="project-<%= jcw.slug %>-title">
      <div class="work-images">
        <% jcw.panelDesigns.map(slug => designs.find(d => d.slug === slug)).forEach(d => { %>
          <img src="<%= asset('images/designs/' + d.slug + '.webp') %>" width="<%= d.width %>" height="<%= d.height %>" alt="Design for Junioura Creative WebDev: <%= d.title %>" loading="lazy">
        <% }) %>
      </div>
      <div class="work-feature-text">
        <div>
          <p class="work-kicker"><%= jcw.category %></p>
          <h3 class="work-title" id="project-<%= jcw.slug %>-title"><%= jcw.title %></h3>
          <p class="work-org"><%= jcw.organisation %></p>
        </div>
        <div>
          <p class="work-desc"><%= jcw.desc %></p>
          <p class="work-meta"><strong>Role:</strong> <%= jcw.role %>. <strong>Tools:</strong> <%= jcw.tools.join(', ') %>.</p>
          <div class="work-links">
            <% jcw.links.filter(l => l.show).forEach(l => { %>
              <% if (l.internal) { %>
                <a class="text-link" href="<%= l.url %>"><%= l.label %> <%- include('../partials/icon', { name: 'arrow' }) %></a>
              <% } else { %>
                <a class="text-link" href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.label %> <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
              <% } %>
            <% }) %>
          </div>
        </div>
      </div>
    </article>

    <%# Two shorter entries side by side %>
    <div class="work-pair">
      <% [nexinch, teaching].forEach(p => { %>
        <article class="work-item" id="project-<%= p.slug %>" aria-labelledby="project-<%= p.slug %>-title">
          <p class="work-kicker"><%= p.category %></p>
          <h3 class="work-title work-title-sm" id="project-<%= p.slug %>-title"><%= p.title %></h3>
          <p class="work-org"><%= p.organisation %></p>
          <p class="work-desc"><%= p.desc %></p>
          <p class="work-meta"><strong>Role:</strong> <%= p.role %>. <strong>Covered:</strong> <%= p.scope.join(', ') %>.</p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%# ============================== GRAPHIC DESIGN ============================== %>
<section class="section section-dark" id="design" aria-labelledby="design-title">
  <div class="container">
    <div class="design-head">
      <h2 id="design-title" class="section-title">Graphic design</h2>
      <p class="section-intro">Flyers and social media designs for my content brand, a digital safety campaign, my personal brand and Nexinch. Select a design to see it larger.</p>
    </div>

    <div class="filters" role="group" aria-label="Filter designs">
      <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">All</button>
      <% designCategories.forEach(c => { %>
        <button type="button" class="filter" data-filter="<%= c.id %>" aria-pressed="false"><%= c.label %></button>
      <% }) %>
    </div>

    <ul class="gallery" aria-label="Designs">
      <% designs.forEach(d => { %>
        <li class="gallery-item" data-category="<%= d.category %>">
          <button class="gallery-open" type="button"
                  data-full="<%= asset('images/designs/' + d.slug + '.webp') %>"
                  data-title="<%= d.title %>" data-meta="<%= d.client %> · <%= d.format %>" data-desc="<%= d.desc %>">
            <img src="<%= asset('images/designs/' + d.slug + '.webp') %>" width="<%= d.width %>" height="<%= d.height %>" alt="<%= d.title %>, <%= d.format.toLowerCase() %> for <%= d.client %>" loading="lazy">
            <span class="visually-hidden">View larger</span>
          </button>
          <h3 class="gallery-title"><%= d.title %></h3>
          <p class="gallery-meta"><%= d.client %> · <%= d.format %></p>
        </li>
      <% }) %>
    </ul>

    <p class="tools-line">Designed with <% designTools.forEach((t, i) => { %><strong><%= t.name %></strong><%= i < designTools.length - 2 ? ', ' : (i === designTools.length - 2 ? ' and ' : '.') %><% }) %> Figma is mainly for website and interface layouts, which I am still learning.</p>
  </div>

  <dialog class="lightbox" aria-labelledby="lightbox-title">
    <form method="dialog"><button class="lightbox-close" type="submit" aria-label="Close"><%- include('../partials/icon', { name: 'close' }) %></button></form>
    <div class="lightbox-inner">
      <div class="lightbox-media"><img alt=""></div>
      <div class="lightbox-text">
        <h3 id="lightbox-title"></h3>
        <p class="lightbox-meta"></p>
        <p class="lightbox-desc"></p>
      </div>
    </div>
  </dialog>
</section>

<%# ============================== DIGITAL COMMUNICATIONS ============================== %>
<section class="section" id="communications" aria-labelledby="communications-title">
  <div class="container comms-grid">
    <div class="comms-intro">
      <h2 id="communications-title" class="section-title">Digital communications</h2>
      <p><%= communications.intro %></p>
      <p class="comms-topics">Topics so far: <%= communications.topics.map(t => t.toLowerCase()).join(', ').replace(/, ([^,]*)$/, ' and $1') %>.</p>
      <p class="comms-links">
        <% owner.social.filter(s => s.name !== 'LinkedIn').forEach((s, i) => { %>
          <a class="text-link" href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.name %> <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
        <% }) %>
      </p>
    </div>

    <ol class="process" aria-label="How a post is made">
      <% communications.process.forEach(p => { %>
        <li>
          <h3><%= p.step %></h3>
          <p><span class="process-skill"><%= p.skill %>.</span> <%= p.text %></p>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<%# ============================== SKILLS ============================== %>
<section class="section section-white" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <h2 id="skills-title" class="section-title">Skills and tools</h2>

    <div class="skill-board">
      <% skills.forEach((g, i) => { %>
        <div class="skill-col">
          <h3><%= g.category.charAt(0).toUpperCase() + g.category.slice(1) %></h3>
          <ul>
            <% g.items.forEach(t => { %><li><%= t %></li><% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%# ============================== EXPERIENCE & EDUCATION ============================== %>
<section class="section" id="background" aria-labelledby="background-title">
  <div class="container">
    <h2 id="background-title" class="section-title">Experience and education</h2>

    <div class="background-grid">
      <div>
        <h3 class="col-title">Experience</h3>
        <ol class="timeline">
          <% experience.forEach(e => { %>
            <li>
              <p class="timeline-when"><%= e.date %><span><%= e.type %></span></p>
              <div>
                <h4><%= e.title %></h4>
                <p class="timeline-org"><%= e.org %></p>
                <p class="timeline-desc"><%= e.desc %></p>
              </div>
            </li>
          <% }) %>
        </ol>

        <h3 class="col-title col-title-gap">Other experience</h3>
        <ul class="other-exp">
          <% otherExperience.forEach(e => { %>
            <li><strong><%= e.title %></strong>, <%= e.org %>, <%= e.date %>. <%= e.desc %></li>
          <% }) %>
        </ul>
      </div>

      <div>
        <h3 class="col-title">Education</h3>
        <ul class="credentials">
          <% education.forEach(ed => { %>
            <li>
              <h4><%= ed.title %>, <%= ed.field %></h4>
              <p><%= ed.org %> · <%= ed.date %></p>
            </li>
          <% }) %>
        </ul>

        <h3 class="col-title col-title-gap">Certifications</h3>
        <ul class="credentials">
          <% certifications.forEach(c => { %>
            <li>
              <h4><%= c.title %></h4>
              <p><%= c.org %> · <%= c.date %></p>
              <% if (c.image) { %>
                <a class="text-link" href="<%= asset(c.image) %>" target="_blank" rel="noopener">View certificate <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<%# ============================== CONTACT ============================== %>
<section class="section section-white section-contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-intro">
      <h2 id="contact-title" class="section-title">Get in touch</h2>
      <p>For a website, a flyer, content for your audience or digital skills training, email or call me. You can also use the form.</p>

      <dl class="contact-details">
        <div><dt>Email</dt><dd><a href="mailto:<%= owner.email %>"><%= owner.email %></a></dd></div>
        <div><dt>Phone</dt><dd><a href="tel:<%= owner.phoneHref %>"><%= owner.phone %></a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href="<%= owner.social[0].url %>" target="_blank" rel="noopener noreferrer"><%= owner.social[0].handle %><span class="visually-hidden"> (opens in a new tab)</span></a></dd></div>
        <div><dt>Based in</dt><dd><%= owner.location %></dd></div>
      </dl>
    </div>

    <div class="contact-form-wrap">
      <% if (contact.status === 'sent') { %>
        <div class="notice notice-success" role="status">
          <h3>Message sent. Thank you.</h3>
          <p>I will get back to you as soon as I can.</p>
          <a class="btn btn-outline" href="<%= base %>#contact">Send another message</a>
        </div>
      <% } else { %>
        <form class="contact-form" method="post" novalidate
              action="<%= isStatic ? 'mailto:' + owner.email : base + 'contact' %>"
              <% if (isStatic) { %>enctype="text/plain" data-mailto="<%= owner.email %>"<% } %>>
          <h3 class="form-title">Send a message</h3>
          <% if (isStatic) { %>
            <p class="form-note">This opens your email app with the message ready to send.</p>
          <% } %>

          <% if (contact.status === 'failed') { %>
            <div class="notice notice-error" role="alert">
              <p>Sorry, your message could not be sent right now. Please email me directly at <a href="mailto:<%= owner.email %>"><%= owner.email %></a>.</p>
            </div>
          <% } %>
          <% if (contact.errors.length) { %>
            <div class="notice notice-error" role="alert">
              <p>Please check the form:</p>
              <ul><% contact.errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
            </div>
          <% } %>

          <div class="field-row">
            <div class="field">
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" autocomplete="name" required minlength="2" maxlength="80" value="<%= contact.values.name || '' %>">
            </div>
            <div class="field">
              <label for="email">Your email</label>
              <input type="email" id="email" name="email" autocomplete="email" required value="<%= contact.values.email || '' %>">
            </div>
          </div>
          <div class="field">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" required minlength="3" maxlength="120" value="<%= contact.values.subject || '' %>">
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required minlength="10" maxlength="2000"><%= contact.values.message || '' %></textarea>
          </div>
          <p class="form-error" role="alert" hidden></p>
          <button class="btn btn-primary" type="submit">Send message</button>
        </form>
      <% } %>
    </div>
  </div>
</section>
