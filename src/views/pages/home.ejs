<%# ============================== HERO ============================== %>
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><%= owner.roles.join(' · ') %></p>
      <h1 id="hero-title" class="hero-title"><span><%= owner.firstName %></span> <span><%= owner.lastName %></span></h1>
      <p class="hero-lead"><%= owner.headline %></p>
      <p class="hero-sub">Based in <%= owner.location %>, I bring together web development, digital communication, design and teaching, so that information and digital tools are easier to reach and understand.</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">View my work <%- include('../partials/icon', { name: 'arrow' }) %></a>
        <a class="btn btn-outline" href="#services">Explore services</a>
      </div>
      <p class="hero-mail">Or email <a href="mailto:<%= owner.email %>"><%= owner.email %></a></p>

      <dl class="hero-now">
        <dt>Currently</dt>
        <% currently.forEach(item => { %><dd><%= item %></dd><% }) %>
      </dl>
    </div>

    <figure class="hero-figure">
      <div class="hero-photo">
        <img src="<%= asset(owner.photo.src) %>" width="<%= owner.photo.width %>" height="<%= owner.photo.height %>" alt="<%= owner.photo.alt %>" fetchpriority="high">
      </div>
      <figcaption>
        <%- include('../partials/icon', { name: 'pin' }) %> <%= owner.location %>
      </figcaption>
    </figure>
  </div>
</section>

<%# ============================== ABOUT ============================== %>
<section class="section section-white" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="section-head reveal">
      <p class="section-label"><span>01</span> About</p>
      <h2 id="about-title" class="section-title">Technology, communication and learning, connected.</h2>
    </div>

    <div class="about-body reveal">
      <p class="about-first"><%= intro[0] %> <%= intro[1] %></p>
      <p><%= intro[2] %></p>
      <p>I studied Biochemistry, trained as a Biology teacher, and then completed a year of intensive web and application development training. Teaching shaped how I work: plan clearly, explain simply, and think about the person on the other side of the screen.</p>
    </div>
  </div>

  <div class="container">
    <ol class="pillars reveal" aria-label="How my work connects">
      <% pillars.forEach((p, i) => { %>
        <li class="pillar">
          <span class="pillar-dot" aria-hidden="true"></span>
          <h3><%= p.title %></h3>
          <p><%= p.text %></p>
        </li>
      <% }) %>
    </ol>

    <dl class="facts reveal">
      <% facts.forEach(f => { %>
        <div class="fact"><dt><%= f.term %></dt><dd><%= f.detail %></dd></div>
      <% }) %>
    </dl>
  </div>
</section>

<%# ============================== SERVICES ============================== %>
<section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head section-head-row reveal">
      <div>
        <p class="section-label"><span>02</span> Services</p>
        <h2 id="services-title" class="section-title">How I can help.</h2>
      </div>
      <p class="section-intro">Five services, one approach: clear structure, simple language and work you can keep using after it is delivered.</p>
    </div>

    <ol class="service-rows">
      <% services.forEach((s, i) => { %>
        <li class="service-row reveal" id="service-<%= s.slug %>">
          <span class="service-num" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></span>
          <div class="service-main">
            <h3 class="service-title"><%= s.title %></h3>
            <p class="service-summary"><%= s.summary %></p>
            <ul class="inline-list">
              <% s.includes.forEach(item => { %><li><%= item %></li><% }) %>
            </ul>
          </div>
          <div class="service-value">
            <p class="mini-label">Why it helps</p>
            <p><%= s.value %></p>
          </div>
          <a class="service-cta" href="#contact" data-subject="<%= s.subject %>">Enquire <%- include('../partials/icon', { name: 'arrow' }) %><span class="visually-hidden"> about <%= s.title %></span></a>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<%# ============================== WORK ============================== %>
<section class="section section-white" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head section-head-row reveal">
      <div>
        <p class="section-label"><span>03</span> Selected work</p>
        <h2 id="work-title" class="section-title">Projects and experience I can show.</h2>
      </div>
      <p class="section-intro">Real projects I have built, managed, written for or trained on.</p>
    </div>

    <div class="projects">
      <% projects.forEach((p, i) => { %>
        <article class="project reveal" id="project-<%= p.slug %>" aria-labelledby="project-<%= p.slug %>-title">
          <div class="project-visual">
            <% if (p.image) { %>
              <img src="<%= asset(p.image) %>" alt="Screenshot of <%= p.title %>" loading="lazy">
            <% } else if (p.panel === 'designs') { %>
              <div class="panel panel-designs">
                <% p.panelDesigns.map(slug => designs.find(d => d.slug === slug)).forEach((d, j) => { %>
                  <img class="stack-<%= j + 1 %>" src="<%= asset('images/designs/' + d.slug + '.webp') %>" width="<%= d.width %>" height="<%= d.height %>" alt="Design: <%= d.title %>" loading="lazy">
                <% }) %>
              </div>
            <% } else if (p.panel === 'site') { %>
              <div class="panel panel-site" aria-hidden="true">
                <span class="panel-kicker">Website · WordPress</span>
                <span class="panel-word">AAGYW<br>CAM</span>
                <ul class="panel-grid">
                  <% p.scope.forEach(s => { %><li><%= s %></li><% }) %>
                </ul>
              </div>
            <% } else if (p.panel === 'code') { %>
              <div class="panel panel-code" aria-hidden="true">
                <span class="panel-kicker">Nexinch · 1 year</span>
<pre><code><span class="c">&lt;!-- what I trained in --&gt;</span>
<span class="t">&lt;section</span> <span class="a">class</span>=<span class="s">"skills"</span><span class="t">&gt;</span>
<% p.scope.forEach(s => { %>  <span class="t">&lt;p&gt;</span><%= s %><span class="t">&lt;/p&gt;</span>
<% }) %><span class="t">&lt;/section&gt;</span></code></pre>
              </div>
            <% } else { %>
              <div class="panel panel-teach" aria-hidden="true">
                <span class="panel-kicker">Learning, made practical</span>
                <ol class="panel-steps">
                  <li><span>Plan</span> lesson and resources</li>
                  <li><span>Explain</span> in simple language</li>
                  <li><span>Practise</span> with real tools</li>
                </ol>
              </div>
            <% } %>
          </div>

          <div class="project-body">
            <p class="project-meta"><span class="project-num"><%= String(i + 1).padStart(2, '0') %></span> <%= p.category %></p>
            <h3 class="project-title" id="project-<%= p.slug %>-title"><%= p.title %></h3>
            <p class="project-org"><%= p.organisation %></p>
            <p class="project-desc"><%= p.desc %></p>

            <dl class="project-details">
              <div><dt>My role</dt><dd><%= p.role %></dd></div>
              <div><dt>Tools</dt><dd><%= p.tools.join(', ') %></dd></div>
              <div><dt>Scope</dt><dd><%= p.scope.join(' · ') %></dd></div>
            </dl>

            <% const visible = p.links.filter(l => l.show); %>
            <% if (visible.length) { %>
              <div class="project-links">
                <% visible.forEach(l => { %>
                  <% if (l.internal) { %>
                    <a class="text-link" href="<%= l.url %>"><%= l.label %> <%- include('../partials/icon', { name: 'arrow' }) %></a>
                  <% } else { %>
                    <a class="text-link" href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.label %> <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
                  <% } %>
                <% }) %>
              </div>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%# ============================== DESIGN ============================== %>
<section class="section section-dark" id="design" aria-labelledby="design-title">
  <div class="container">
    <div class="section-head section-head-row reveal">
      <div>
        <p class="section-label"><span>04</span> Graphic design</p>
        <h2 id="design-title" class="section-title">Designs that explain things simply.</h2>
      </div>
      <p class="section-intro">Selected flyers and social media designs for my content brand, digital safety awareness, my personal brand and Nexinch. Select any design to see it larger.</p>
    </div>

    <div class="filters reveal" role="group" aria-label="Filter designs by category">
      <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">All <span><%= designs.length %></span></button>
      <% designCategories.forEach(c => { %>
        <button type="button" class="filter" data-filter="<%= c.id %>" aria-pressed="false"><%= c.label %> <span><%= designs.filter(d => d.category === c.id).length %></span></button>
      <% }) %>
    </div>

    <ul class="gallery" aria-label="Design samples">
      <% designs.forEach(d => { const cat = designCategories.find(c => c.id === d.category); %>
        <li class="gallery-item" data-category="<%= d.category %>">
          <button class="gallery-open" type="button"
                  data-full="<%= asset('images/designs/' + d.slug + '.webp') %>"
                  data-title="<%= d.title %>" data-meta="<%= d.client %> · <%= d.format %>" data-desc="<%= d.desc %>">
            <img src="<%= asset('images/designs/' + d.slug + '.webp') %>" width="<%= d.width %>" height="<%= d.height %>" alt="<%= d.title %>, <%= d.format.toLowerCase() %> for <%= d.client %>" loading="lazy">
            <span class="gallery-zoom" aria-hidden="true">View larger</span>
          </button>
          <div class="gallery-caption">
            <span class="gallery-cat"><%= cat.label %></span>
            <h3><%= d.title %></h3>
            <p><%= d.client %> · <%= d.format %></p>
          </div>
        </li>
      <% }) %>
    </ul>

    <div class="tools reveal">
      <h3 class="tools-title">Design tools</h3>
      <ul class="tools-list">
        <% designTools.forEach(t => { %>
          <li><strong><%= t.name %></strong><span><%= t.use %></span></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <dialog class="lightbox" aria-labelledby="lightbox-title">
    <form method="dialog"><button class="lightbox-close" type="submit" aria-label="Close"><%- include('../partials/icon', { name: 'close' }) %></button></form>
    <div class="lightbox-inner">
      <div class="lightbox-media"><img alt=""></div>
      <div class="lightbox-text">
        <p class="lightbox-meta"></p>
        <h3 id="lightbox-title"></h3>
        <p class="lightbox-desc"></p>
      </div>
    </div>
  </dialog>
</section>

<%# ============================== DIGITAL COMMUNICATIONS ============================== %>
<section class="section" id="communications" aria-labelledby="communications-title">
  <div class="container">
    <div class="section-head section-head-row reveal">
      <div>
        <p class="section-label"><span>05</span> Digital communications</p>
        <h2 id="communications-title" class="section-title">Content that helps people use technology well.</h2>
      </div>
      <p class="section-intro"><%= communications.intro %></p>
    </div>

    <ol class="process">
      <% communications.process.forEach((p, i) => { %>
        <li class="process-step reveal">
          <span class="process-num" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></span>
          <h3><%= p.step %></h3>
          <p class="process-skill"><%= p.skill %></p>
          <p><%= p.text %></p>
        </li>
      <% }) %>
    </ol>

    <div class="comms-footer reveal">
      <div class="comms-topics">
        <h3 class="col-title">Topics I cover</h3>
        <ul class="inline-list inline-list-lg">
          <% communications.topics.forEach(t => { %><li><%= t %></li><% }) %>
        </ul>
      </div>
      <div class="comms-channels">
        <h3 class="col-title">Follow the work</h3>
        <ul class="channel-list">
          <% owner.social.filter(s => s.name !== 'LinkedIn').forEach(s => { %>
            <li>
              <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer">
                <%- include('../partials/icon', { name: s.name.toLowerCase() }) %>
                <span><strong><%= s.name %></strong><%= s.handle %></span>
                <%- include('../partials/icon', { name: 'external', className: 'channel-arrow' }) %>
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<%# ============================== SKILLS ============================== %>
<section class="section section-white" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <div class="section-head section-head-row reveal">
      <div>
        <p class="section-label"><span>06</span> Skills &amp; tools</p>
        <h2 id="skills-title" class="section-title">What I work with.</h2>
      </div>
      <p class="section-intro">Grouped by area of work. No ratings or percentages, just the skills and tools I use.</p>
    </div>

    <div class="skill-board">
      <% skills.forEach((g, i) => { %>
        <section class="skill-col reveal" aria-labelledby="skill-<%= i %>">
          <h3 id="skill-<%= i %>"><%= g.category %></h3>
          <p class="skill-note"><%= g.note %></p>
          <ul>
            <% g.items.forEach(t => { %><li><%= t %></li><% }) %>
          </ul>
        </section>
      <% }) %>
    </div>
  </div>
</section>

<%# ============================== BACKGROUND ============================== %>
<section class="section" id="background" aria-labelledby="background-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="section-label"><span>07</span> Experience &amp; education</p>
      <h2 id="background-title" class="section-title">Where I have learned and worked.</h2>
    </div>

    <div class="background-grid">
      <div class="reveal">
        <h3 class="col-title">Experience</h3>
        <ol class="timeline">
          <% experience.forEach(e => { %>
            <li>
              <div class="timeline-when">
                <p class="timeline-date"><%= e.date %></p>
                <p class="timeline-type"><%= e.type %></p>
              </div>
              <div>
                <h4><%= e.title %></h4>
                <p class="timeline-org"><%= e.org %></p>
                <p><%= e.desc %></p>
              </div>
            </li>
          <% }) %>
        </ol>

        <h3 class="col-title col-title-gap col-title-quiet">Other experience</h3>
        <ul class="other-exp">
          <% otherExperience.forEach(e => { %>
            <li><strong><%= e.title %></strong><span class="oe-meta"><%= e.org %> · <%= e.date %></span><%= e.desc %></li>
          <% }) %>
        </ul>
      </div>

      <div class="reveal">
        <h3 class="col-title">Education</h3>
        <ul class="credentials">
          <% education.forEach(ed => { %>
            <li>
              <p class="credential-date"><%= ed.date %></p>
              <h4><%= ed.title %></h4>
              <p><%= ed.field %> · <%= ed.org %></p>
            </li>
          <% }) %>
        </ul>

        <h3 class="col-title col-title-gap">Certifications</h3>
        <ul class="credentials">
          <% certifications.forEach(c => { %>
            <li>
              <p class="credential-date"><%= c.date %></p>
              <h4><%= c.title %></h4>
              <p><%= c.org %></p>
              <% if (c.image) { %>
                <a class="text-link" href="<%= asset(c.image) %>" target="_blank" rel="noopener">View certificate <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<%# ============================== CONTACT ============================== %>
<section class="section section-contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-intro reveal">
      <p class="section-label"><span>08</span> Contact</p>
      <h2 id="contact-title" class="section-title">Let’s work together.</h2>
      <p class="section-intro">Need a website built or updated, a flyer designed, content for your audience, or someone to teach digital skills? Send me a message. I usually reply by email or phone.</p>

      <ul class="contact-list">
        <li>
          <%- include('../partials/icon', { name: 'mail' }) %>
          <div><span>Email</span><a href="mailto:<%= owner.email %>"><%= owner.email %></a></div>
        </li>
        <li>
          <%- include('../partials/icon', { name: 'phone' }) %>
          <div><span>Phone</span><a href="tel:<%= owner.phoneHref %>"><%= owner.phone %></a></div>
        </li>
        <li>
          <%- include('../partials/icon', { name: 'linkedin' }) %>
          <div><span>LinkedIn</span><a href="<%= owner.social[0].url %>" target="_blank" rel="noopener noreferrer"><%= owner.social[0].handle %><span class="visually-hidden"> (opens in a new tab)</span></a></div>
        </li>
        <li>
          <%- include('../partials/icon', { name: 'pin' }) %>
          <div><span>Location</span><p><%= owner.location %></p></div>
        </li>
      </ul>
    </div>

    <div class="contact-form-wrap reveal">
      <% if (contact.status === 'sent') { %>
        <div class="notice notice-success" role="status">
          <h3>Message sent. Thank you!</h3>
          <p>I will get back to you as soon as I can.</p>
          <a class="btn btn-outline" href="<%= base %>#contact">Send another message</a>
        </div>
      <% } else { %>
        <form class="contact-form" method="post" novalidate
              action="<%= isStatic ? 'mailto:' + owner.email : base + 'contact' %>"
              <% if (isStatic) { %>enctype="text/plain" data-mailto="<%= owner.email %>"<% } %>>
          <h3 class="form-title">Send a message</h3>
          <% if (isStatic) { %>
            <p class="form-note">This opens your email app with your message ready to send.</p>
          <% } %>

          <% if (contact.status === 'failed') { %>
            <div class="notice notice-error" role="alert">
              <p>Sorry, your message could not be sent right now. Please email me directly at <a href="mailto:<%= owner.email %>"><%= owner.email %></a>.</p>
            </div>
          <% } %>
          <% if (contact.errors.length) { %>
            <div class="notice notice-error" role="alert">
              <p>Please check the form:</p>
              <ul><% contact.errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
            </div>
          <% } %>

          <div class="field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" autocomplete="name" required minlength="2" maxlength="80" value="<%= contact.values.name || '' %>">
          </div>
          <div class="field">
            <label for="email">Your email</label>
            <input type="email" id="email" name="email" autocomplete="email" required value="<%= contact.values.email || '' %>">
          </div>
          <div class="field">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" required minlength="3" maxlength="120" value="<%= contact.values.subject || '' %>">
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required minlength="10" maxlength="2000"><%= contact.values.message || '' %></textarea>
          </div>
          <p class="form-error" role="alert" hidden></p>
          <button class="btn btn-primary" type="submit">Send message <%- include('../partials/icon', { name: 'arrow' }) %></button>
        </form>
      <% } %>
    </div>
  </div>
</section>
