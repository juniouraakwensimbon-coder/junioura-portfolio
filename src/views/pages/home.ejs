<%
  const aagyw = projects.find(p => p.slug === 'aagyw-cam');
  const featuredDesign = designs.find(d => d.slug === 'who-needs-a-website');
  const calendarDoc = documents.find(d => d.slug === 'lesson-calendar');
  const selectedCreds = credentials.filter(c => ['dipes', 'bsc', 'nexinch-certificate', 'youth-digital-safety'].includes(c.slug));
%>

<%# ============================== HERO ============================== %>
<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker"><%= owner.roles.join(' · ') %></p>
      <h1 id="hero-title" class="hero-title"><%= owner.name %></h1>
      <p class="hero-intro"><%= owner.heroIntro %></p>

      <ul class="hero-areas" aria-label="Professional areas">
        <% owner.heroAreas.forEach(h => { %>
          <li><%- include('../partials/icon', { name: h.icon }) %><%= h.title %></li>
        <% }) %>
      </ul>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#selected-work">View my work</a>
        <a class="btn btn-ghost" href="#contact">Contact me</a>
      </div>
    </div>
    <figure class="hero-figure">
      <img src="<%= asset(owner.photo.src) %>" width="<%= owner.photo.width %>" height="<%= owner.photo.height %>" alt="<%= owner.photo.alt %>" fetchpriority="high">
      <figcaption><%- include('../partials/icon', { name: 'pin' }) %> <%= owner.location %></figcaption>
    </figure>
  </div>
</section>

<%# ============================== PATHWAYS ============================== %>
<section class="section pathways" id="pathways" aria-labelledby="pathways-title">
  <div class="container">
    <%- include('../partials/section-heading', { id: 'pathways-title', title: 'What I do', intro: 'Three connected areas of work that support each other: websites people can use, content and visuals that communicate, and teaching that makes learning stick.' }) %>
    <ul class="pathway-grid">
      <% pathways.forEach(p => { %>
        <li class="pathway pathway-<%= p.id %>">
          <span class="pathway-icon"><%- include('../partials/icon', { name: p.icon }) %></span>
          <h3><a class="pathway-link" href="<%= pageUrl(p.id) %>"><%= p.title %></a></h3>
          <p><%= p.summary %></p>
          <span class="pathway-cta" aria-hidden="true"><%= p.cta %> <%- include('../partials/icon', { name: 'arrow' }) %></span>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<%# ============================== SELECTED WORK ============================== %>
<section class="section selected" id="selected-work" aria-labelledby="selected-title">
  <div class="container">
    <%- include('../partials/section-heading', { id: 'selected-title', title: 'Selected work', intro: 'One example from each area. Each links to the full details.' }) %>

    <div class="selected-grid">
      <article class="sel sel-web">
        <a class="sel-media" href="<%= pageUrl('web', 'project-aagyw-cam') %>">
          <img src="<%= asset(aagyw.images[0].src) %>" width="<%= aagyw.images[0].width %>" height="<%= aagyw.images[0].height %>" alt="<%= aagyw.images[0].alt %>" loading="lazy">
        </a>
        <div class="sel-body">
          <p class="sel-area">Web Development</p>
          <h3><a href="<%= pageUrl('web', 'project-aagyw-cam') %>"><%= aagyw.title %></a></h3>
          <p><%= aagyw.role %> Built with <%= aagyw.tools.join(' and ') %>.</p>
          <a class="text-link" href="<%= aagyw.link.url %>" target="_blank" rel="noopener noreferrer">aagyw-cam.org <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
      </article>

      <article class="sel sel-comms">
        <a class="sel-media" href="<%= pageUrl('comms', 'samples') %>">
          <img src="<%= asset('images/designs/' + featuredDesign.slug + '.webp') %>" width="<%= featuredDesign.width %>" height="<%= featuredDesign.height %>" alt="<%= featuredDesign.title %>, <%= featuredDesign.format.toLowerCase() %>" loading="lazy">
        </a>
        <div class="sel-body">
          <p class="sel-area">Digital Communications</p>
          <h3><a href="<%= pageUrl('comms', 'samples') %>"><%= featuredDesign.title %></a></h3>
          <p>A post for Junioura Creative WebDev. <%= featuredDesign.purpose %>.</p>
        </div>
      </article>

      <article class="sel sel-edu">
        <a class="sel-media" href="<%= pageUrl('edu', 'programme') %>">
          <img src="<%= asset(calendarDoc.src) %>" width="<%= calendarDoc.width %>" height="<%= calendarDoc.height %>" alt="First page of the lesson calendar for the <%= programme.title %>" loading="lazy">
        </a>
        <div class="sel-body">
          <p class="sel-area">Education</p>
          <h3><a href="<%= pageUrl('edu', 'programme') %>"><%= programme.title %></a></h3>
          <p>A 30-lesson course I developed for complete beginners, <%= programme.dates %>.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<%# ============================== BACKGROUND ============================== %>
<section class="section background-section" id="background" aria-labelledby="background-title">
  <div class="container">
    <%- include('../partials/section-heading', { id: 'background-title', title: 'Professional background' }) %>
    <div class="background-grid">
    <div>
      <p class="lead"><%= story[0] %></p>
      <p><%= story[1] %></p>
      <a class="text-link" href="<%= pageUrl('about') %>">Read my story <%- include('../partials/icon', { name: 'arrow' }) %></a>
    </div>
    <dl class="facts">
      <% facts.forEach(f => { %><div><dt><%= f.term %></dt><dd><%= f.detail %></dd></div><% }) %>
      <div><dt>Works with</dt><dd>WordPress, Elementor, HTML, CSS, JavaScript, Canva, Adobe Illustrator, Adobe Photoshop, Figma</dd></div>
    </dl>
    </div>
  </div>
</section>

<%# ============================== CREDENTIALS ============================== %>
<section class="section home-creds" id="credentials" aria-labelledby="home-creds-title">
  <div class="container">
    <%- include('../partials/section-heading', { id: 'home-creds-title', title: 'Education and professional development', intro: 'Selected qualifications and certificates.' }) %>
    <ul class="cred-rows">
      <% selectedCreds.forEach(c => { %>
        <li>
          <p class="cred-kind"><%= c.kind %></p>
          <h3><%= c.title %></h3>
          <p class="cred-org"><%= c.org %> · <%= c.date %></p>
        </li>
      <% }) %>
    </ul>
    <p class="section-more"><a class="text-link" href="<%= pageUrl('about', 'credentials') %>">All credentials <%- include('../partials/icon', { name: 'arrow' }) %></a></p>
  </div>
</section>

<%- include('../partials/contact') %>
