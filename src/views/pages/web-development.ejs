<%
  const webProjects = projects.filter(p => p.area === 'web');
  const [featured, ...others] = webProjects;
  const webExperience = experience.filter(e => e.areas.includes('web'));
  const webCreds = credentials.filter(c => c.areas.includes('web'));
%>
<%- include('../partials/page-hero', { heading: 'Web Development', intro: web.intro, jumps: [
  { id: 'skills', label: 'Skills and tools' }, { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' }, { id: 'certificates', label: 'Certificates' } ] }) %>

<section class="section section-white" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <%- include('../partials/section-heading', { id: 'skills-title', title: 'Skills and tools', intro: 'What I use to build and look after websites, grouped by the job it does.' }) %>
    <%- include('../partials/skill-groups', { groups: web.skills }) %>
  </div>
</section>

<section class="section section-cool" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <%- include('../partials/section-heading', { id: 'projects-title', title: 'Projects', intro: 'Real websites and real training work, with what I actually did on each.' }) %>
    <%- include('../partials/project', { p: featured, featured: true }) %>
    <div class="case-pair">
      <% others.forEach(p => { %><%- include('../partials/project', { p, featured: false }) %><% }) %>
    </div>
  </div>
</section>

<section class="section section-white" id="experience" aria-labelledby="experience-title">
  <div class="container section-narrow">
    <%- include('../partials/section-heading', { id: 'experience-title', title: 'Experience', intro: 'Website work, most recent first.' }) %>
    <%- include('../partials/timeline', { items: webExperience }) %>
  </div>
</section>

<section class="section section-cool" id="certificates" aria-labelledby="certificates-title">
  <div class="container section-narrow">
    <%- include('../partials/section-heading', { id: 'certificates-title', title: 'Certificates', intro: 'Select the certificate to read it at full size.' }) %>
    <ul class="cred-list">
      <% webCreds.forEach(c => { %><%- include('../partials/credential', { c }) %><% }) %>
    </ul>
  </div>
</section>

<%- include('../partials/enquiry', { e: web.enquiry }) %>
<%- include('../partials/lightbox') %>
