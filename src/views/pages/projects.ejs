<section class="projects-page section-reveal">
    <div class="container">
        <h2 class="section-title">My Projects</h2>
        
        <div class="portfolio-filter">
            <a href="/projects?category=all" class="filter-btn <%= active === 'all' ? 'active' : '' %>">All</a>
            <a href="/projects?category=web" class="filter-btn <%= active === 'web' ? 'active' : '' %>">Web Dev</a>
            <a href="/projects?category=education" class="filter-btn <%= active === 'education' ? 'active' : '' %>">Education</a>
            <a href="/projects?category=business" class="filter-btn <%= active === 'business' ? 'active' : '' %>">Business</a>
        </div>

        <div class="portfolio-grid">
            <% projects.forEach(project => { %>
                <div class="portfolio-card">
                    <div class="portfolio-img">
                        <img src="<%= project.image %>" alt="<%= project.title %>">
                        <div class="portfolio-overlay">
                            <% if (project.demo) { %>
                                <a href="<%= project.demo %>" class="portfolio-link"><i class="fa-solid fa-link"></i> Demo</a>
                            <% } %>
                            <% if (project.code) { %>
                                <a href="<%= project.code %>" class="portfolio-link"><i class="fa-brands fa-github"></i> Code</a>
                            <% } %>
                        </div>
                    </div>
                    <div class="portfolio-info">
                        <h3><%= project.title %></h3>
                        <p><%= project.desc %></p>
                        <div class="tech-stack">
                            <% project.stack.forEach(tech => { %>
                                <span><%= tech %></span>
                            <% }) %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>
