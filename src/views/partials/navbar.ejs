<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="wordmark" href="<%= pageUrl('home') %>" aria-label="<%= owner.name %>, home">
      <span class="wordmark-mark" aria-hidden="true"><%= owner.initials %></span>
      <span class="wordmark-text">
        <span class="wordmark-name"><%= owner.name %></span>
        <span class="wordmark-role"><%= owner.roles.join(' · ') %></span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-open"><%- include('icon', { name: 'menu' }) %></span>
      <span class="nav-toggle-close"><%- include('icon', { name: 'close' }) %></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
<%
  const navLinks = [
    { label: 'Home', href: section('home'), page: 'home' },
    { label: 'About', href: pageUrl('about'), page: 'about' },
    { label: 'Services', href: section('pathways') },
    { label: 'Portfolio', href: section('selected-work') },
    { label: 'Experience', href: pageUrl('about', 'experience') },
    { label: 'Skills', href: pageUrl('web', 'skills') },
    { label: 'Education', href: pageUrl('edu'), page: 'edu' },
    { label: 'Contact', href: section('contact') },
  ];
%>
        <% navLinks.forEach(l => { %>
          <li><a href="<%= l.href %>"<% if (l.page && l.page === pageId && l.page !== 'home') { %> aria-current="page"<% } %>><%= l.label %></a></li>
        <% }) %>
        <li class="nav-cta-item"><a class="btn btn-primary btn-sm" href="<%= section('contact') %>">Contact me</a></li>
      </ul>
    </nav>
  </div>
</header>
