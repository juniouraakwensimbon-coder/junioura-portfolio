<%# Sub-page header. Expects: heading, intro (array of paragraphs), jumps ([{ id, label }]) %>
<section class="page-hero" aria-labelledby="page-title">
  <div class="container page-hero-grid">
    <div class="page-hero-copy">
      <h1 id="page-title" class="page-title"><%= heading %></h1>
      <% intro.forEach(p => { %><p class="page-intro"><%= p %></p><% }) %>
    </div>
    <nav class="jump" aria-label="On this page">
      <p class="jump-label">On this page</p>
      <ul>
        <% jumps.forEach(j => { %><li><a href="#<%= j.id %>"><%= j.label %></a></li><% }) %>
      </ul>
    </nav>
  </div>
</section>
