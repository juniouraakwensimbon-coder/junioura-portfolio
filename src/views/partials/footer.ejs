<footer class="footer">
  <div class="container">
    <div class="footer-top">

      <div class="footer-brand">
        <h3><%= owner.initials %></h3>
        <p>Bridging Education, Technology, and Entrepreneurship.</p>
      </div>

      <div class="footer-links">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/#business">Business</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="footer-social">
        <h4>Connect</h4>
        <div class="social-icons">
          <a href="<%= owner.social.linkedin %>" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
          <a href="<%= owner.social.github %>" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
          <a href="<%= owner.social.twitter %>" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
          <a href="<%= owner.social.instagram %>" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        </div>
      </div>

    </div>
    <div class="footer-bottom">
      <p>&copy; <%= year %> <%= owner.name %>. All Rights Reserved.</p>
    </div>
  </div>
</footer>
