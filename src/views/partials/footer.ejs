<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href="<%= pageUrl('home') %>" aria-label="<%= owner.name %>, home">
        <img class="logo-mark" src="<%= asset('images/branding/ja-logo.png') %>" width="196" height="192" alt="">
        <span class="footer-name"><%= owner.name %></span>
      </a>
      <p class="footer-role"><%= owner.roles.join(' · ') %></p>
      <p class="footer-statement"><%= owner.closing %></p>
    </div>

    <nav class="footer-col" aria-label="Footer: pages">
      <h2>Pages</h2>
      <ul>
        <% pages.forEach(p => { %><li><a href="<%= pageUrl(p.id) %>"><%= p.label %></a></li><% }) %>
      </ul>
    </nav>

    <div class="footer-col">
      <h2>Contact</h2>
      <ul>
        <li><a href="mailto:<%= owner.email %>"><%= owner.email %></a></li>
        <li><a href="tel:<%= owner.phoneHref %>"><%= owner.phone %></a></li>
        <li><span><%= owner.location %></span></li>
        <li><a href="<%= contactUrl() %>">Send a message</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>Follow</h2>
      <ul class="footer-social" aria-label="Social profiles">
        <% owner.social.forEach(s => { %>
          <li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s.name %> (opens in a new tab)"><%- include('icon', { name: s.name.toLowerCase() }) %></a></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; <%= year %> <%= owner.name %>. All rights reserved.</p>
    <a class="back-to-top" href="#top">Back to top <%- include('icon', { name: 'up' }) %></a>
  </div>
</footer>
