<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="footer-logo" href="<%= isHome ? '#top' : base %>" aria-label="<%= owner.name %>, back to top">
        <span class="wordmark-mark" aria-hidden="true"><%= owner.initials %></span>
      </a>
      <p class="footer-name"><%= owner.name %></p>
      <p class="footer-statement"><%= owner.closing %></p>
      <p class="footer-contact-line">
        <a href="mailto:<%= owner.email %>"><%= owner.email %></a>
        <a href="tel:<%= owner.phoneHref %>"><%= owner.phone %></a>
      </p>
    </div>

    <nav class="footer-col" aria-label="Footer: sections">
      <h2>On this page</h2>
      <ul>
        <li><a href="<%= section('about') %>">About</a></li>
        <li><a href="<%= section('work') %>">Selected work</a></li>
        <li><a href="<%= section('design') %>">Graphic design</a></li>
        <li><a href="<%= section('communications') %>">Digital communications</a></li>
        <li><a href="<%= section('skills') %>">Skills and tools</a></li>
        <li><a href="<%= section('background') %>">Experience and education</a></li>
        <li><a href="<%= section('contact') %>">Contact</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Footer: services">
      <h2>Services</h2>
      <ul>
        <% services.forEach(s => { %>
          <li><a href="<%= section('service-' + s.slug) %>"><%= s.title %></a></li>
        <% }) %>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>&copy; <%= year %> <%= owner.name %> · <%= owner.location %></p>
    <ul class="footer-social" aria-label="Social profiles">
      <% owner.social.forEach(s => { %>
        <li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.name %><span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <% }) %>
      <li><a href="#top">Back to top</a></li>
    </ul>
  </div>
</footer>
