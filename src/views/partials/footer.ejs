<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-name"><%= owner.name %></p>
      <p class="footer-role"><%= owner.roles.join(' · ') %></p>
      <p class="footer-place"><%= owner.location %></p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <ul>
        <li><a href="<%= section('about') %>">About</a></li>
        <li><a href="<%= section('work') %>">Work</a></li>
        <li><a href="<%= section('design') %>">Design</a></li>
        <li><a href="<%= section('communications') %>">Content</a></li>
        <li><a href="<%= section('skills') %>">Skills</a></li>
        <li><a href="<%= section('background') %>">Background</a></li>
        <li><a href="<%= section('contact') %>">Contact</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <a href="mailto:<%= owner.email %>"><%= owner.email %></a>
      <a href="tel:<%= owner.phoneHref %>"><%= owner.phone %></a>
      <ul class="social-list" aria-label="Social profiles">
        <% owner.social.forEach(s => { %>
          <li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s.name %> (opens in a new tab)"><%- include('icon', { name: s.name.toLowerCase() }) %></a></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; <%= year %> <%= owner.name %>. Built with Node.js, Express and EJS.</p>
    <a class="back-to-top" href="#top">Back to top <%- include('icon', { name: 'up' }) %></a>
  </div>
</footer>
