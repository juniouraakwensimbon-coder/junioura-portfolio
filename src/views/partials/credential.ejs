<%# One credential. Image = view-only preview; no image = text entry. Expects: c %>
<li class="cred <%= c.image ? 'cred-image' : 'cred-text' %>">
  <% if (c.image) { %>
    <button class="cred-preview gallery-open" type="button"
            data-full="<%= asset(c.image.src) %>"
            data-title="<%= c.title %>" data-meta="<%= c.kind %> · <%= c.org %>" data-desc="<%= c.date %><%= c.detail ? ' · ' + c.detail : '' %>">
      <img src="<%= asset(c.image.src) %>" width="<%= c.image.width %>" height="<%= c.image.height %>" alt="<%= c.kind %>: <%= c.title %>, issued to Junioura Akwensimbom" loading="lazy">
      <span class="cred-zoom"><%- include('icon', { name: 'search' }) %> View larger</span>
    </button>
  <% } %>
  <div class="cred-body">
    <p class="cred-kind"><%= c.kind %></p>
    <h3><%= c.title %></h3>
    <% if (c.detail) { %><p class="cred-detail"><%= c.detail %></p><% } %>
    <p class="cred-org"><%= c.org %></p>
    <p class="cred-date"><%= c.date %></p>
  </div>
</li>
